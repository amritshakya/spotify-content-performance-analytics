# Raw and processed data (never commit large/derived data artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# DuckDB database file
*.duckdb
*.duckdb.wal

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/
env/

# OS / editor
.DS_Store
.vscode/
.idea/

# Test / coverage artifacts
.coverage
htmlcov/
